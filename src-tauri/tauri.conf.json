{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koffer",
  "version": "0.1.0",
  "identifier": "io.github.yaghmo.koffer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Koffer",
        "width": 900,
        "height": 700,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Koffer",
    "copyright": "",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEQTk2OUFCMzIwNEEwODgKUldTSW9BUXlxMm1wN1dJeEVOdVllUXpiaXgreDJ5YjlWVHJiZ0E5UkZ3T0c1NXZGYUdZY2w3ZjUK",
      "endpoints": ["https://github.com/yaghmo/Koffer/releases/latest/download/latest.json"]
    }
  }
}
